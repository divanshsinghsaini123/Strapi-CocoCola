{
  "collectionName": "components_shared_custom_scripts",
  "info": {
    "displayName": "Custom Script",
    "icon": "code"
  },
  "options": {},
  "attributes": {
    "scriptName": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "scriptCode": {
      "type": "text",
      "required": true
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "Head",
        "BodyStart",
        "BodyEnd"
      ],
      "default": "BodyEnd",
      "required": true
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "config": {}
}
