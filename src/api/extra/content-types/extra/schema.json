{
  "kind": "singleType",
  "collectionName": "extras",
  "info": {
    "singularName": "extra",
    "pluralName": "extras",
    "displayName": "Extra"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "StickyNavbar": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "navLinks": {
      "type": "component",
      "component": "default.nav-links",
      "repeatable": true
    },
    "Copyright": {
      "type": "string",
      "default": "© 2025 The Cloud9 Beverages Company. All rights reserved.",
      "maxLength": 100,
      "required": true
    },
    "globalConfig": {
      "type": "component",
      "component": "shared.global-config",
      "repeatable": false
    }
  }
}
